# palette.env — RENDERED by the swayctl theme engine from the active
# palette (swayctl/themes/<name>/palette.sh); do not edit by hand.
# Sourced by ~/.config/swaybar/status.sh for per-block colors (hex, no '#').
SWAYBAR_ACCENT=@@ACCENT@@
SWAYBAR_RED=@@RED@@
SWAYBAR_GREEN=@@GREEN@@
SWAYBAR_YELLOW=@@YELLOW@@
SWAYBAR_TEXT=@@TEXT@@
SWAYBAR_SUBTEXT=@@SUBTEXT0@@
